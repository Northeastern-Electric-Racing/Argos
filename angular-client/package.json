{
  "name": "angular-client",
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ng": "ng",
    "lint": "npx eslint .",
    "prettier-check": "npx prettier --check .",
    "start": "ng serve",
    "build": "ng build",
    "build:production": "ng build --configuration production",
    "start:production": "ng serve --configuration production --host 0.0.0.0",
    "install-dependencies": "npm install",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false"
  },
  "private": true,
  "dependencies": {
    "@angular/build": "22.2.3",
    "@angular/cdk": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@primeuix/themes": "2.0.3",
    "@types/mapbox-gl": "^2.7.19",
    "apexcharts": "^5.16.0",
    "mapbox-gl": "^3.1.0",
    "material-design-icons": "^3.0.1",
    "ng-apexcharts": "2.5.0",
    "primeflex": "^4.0.0",
    "primeicons": "7.0.0",
    "primeng": "21.1.10",
    "rxjs": "~7.8.0",
    "select": "^1.1.2",
    "socket.io-client": "^4.7.2",
    "tslib": "^2.3.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "angular-eslint": "22.6.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-rxjs-angular-x": "^1.0.1",
    "jsdom": "^30.1.3",
    "prettier": "3.2.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "primeng": {
      "@angular/cdk": "$@angular/cdk",
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/forms": "$@angular/forms",
      "@angular/platform-browser": "$@angular/platform-browser",
      "@angular/router": "$@angular/router"
    }
  }
}
