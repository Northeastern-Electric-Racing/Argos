"420" height="44" as="geometry"/></mxCell><mxCell id="c165" value="db" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D7DEE7;fontColor=#1F2937;fontSize=15;fontFamily=Helvetica;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="1750" width="220" height="44" as="geometry"/></mxCell><mxCell id="c166" value="Postgres on its own" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D7DEE7;fontColor=#1F2937;fontSize=15;fontFamily=Helvetica;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="268" y="1750" width="520" height="44" as="geometry"/></mxCell><mxCell id="c167" value="—" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D7DEE7;fontColor=#1F2937;fontSize=15;fontFamily=Helvetica;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="788" y="1750" width="440" height="44" as="geometry"/></mxCell><mxCell id="c168" value="—" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D7DEE7;fontColor=#1F2937;fontSize=15;fontFamily=Helvetica;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1228" y="1750" width="440" height="44" as="geometry"/></mxCell><mxCell id="c169" value="—" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D7DEE7;fontColor=#1F2937;fontSize=15;fontFamily=Helvetica;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1668" y="1750" width="380" height="44" as="geometry"/></mxCell><mxCell id="c170" value="—" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#D7DEE7;fontColor=#1F2937;fontSize=15;fontFamily=Helvetica;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2048" y="1750" width="420" height="44" as="geometry"/></mxCell><mxCell id="t171" value="&lt;div style=&quot;font-size:15px;color:#475569;line-height:160%&quot;&gt;&lt;b style=&quot;font-size:17px;color:#0F172A&quot;&gt;Notes&lt;/b&gt;&lt;br&gt;Published host ports all read from environment variables (&lt;i&gt;ODYSSEY_DB_PORT&lt;/i&gt;, &lt;i&gt;SCYLLA_HOST_PORT&lt;/i&gt;, &lt;i&gt;CLIENT_HOST_PORT&lt;/i&gt;, &lt;i&gt;SIREN_MQTT_PORT&lt;/i&gt;, &lt;i&gt;SIREN_WS_PORT&lt;/i&gt;, &lt;i&gt;GRAFANA_HOST_PORT&lt;/i&gt;) and &lt;i&gt;STACK_OFFSET&lt;/i&gt; namespaces the compose project, so two dev stacks can run side by side — except the Zenoh router, whose 7447/7446 are still fixed.&lt;br&gt;Images publish to &lt;i&gt;ghcr.io/northeastern-electric-racing/{argos-scylla, argos-client}&lt;/i&gt;. Four path-filtered CI workflows gate every PR — &lt;i&gt;client-ci&lt;/i&gt; and &lt;i&gt;test-check&lt;/i&gt; for the frontend, &lt;i&gt;scylla-ci&lt;/i&gt; and &lt;i&gt;build-check&lt;/i&gt; for the backend — each reporting through an always-run &lt;i&gt;*-gate&lt;/i&gt; job so a filtered PR never deadlocks.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="48" y="1834" width="2420" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>