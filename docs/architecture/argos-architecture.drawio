<mxPoint x="1614" y="118"/><mxPoint x="1614" y="288"/></Array></mxGeometry></mxCell><mxCell id="e46" value="video" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;strokeColor=#8A94A6;strokeWidth=2.5;fontFamily=Helvetica;fontSize=14;fontColor=#8A94A6;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;dashed=1;dashPattern=8 5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e47" value="dump" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;strokeColor=#4F8C3C;strokeWidth=3;fontFamily=Helvetica;fontSize=14;fontColor=#4F8C3C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1592" y="1246"/><mxPoint x="1592" y="1330"/><mxPoint x="306" y="1330"/></Array></mxGeometry></mxCell><mxCell id="e48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;strokeColor=#4F8C3C;strokeWidth=3;fontFamily=Helvetica;fontSize=14;fontColor=#4F8C3C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n25" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e49" value="upload + audit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;strokeColor=#4F8C3C;strokeWidth=3;fontFamily=Helvetica;fontSize=14;fontColor=#4F8C3C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.78;entryDx=0;entryDy=0;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"><mxPoint x="-96" y="-30" as="offset"/></mxGeometry></mxCell><mxCell id="t50" value="&lt;b style=&quot;font-size:17px;color:#0F172A&quot;&gt;Legend&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#334155;margin-top:8px&quot;&gt;&lt;span style=&quot;color:#1F6FD0;font-size:22px&quot;&gt;&amp;#9644;&lt;/span&gt;&amp;nbsp;telemetry&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#C0504A;font-size:22px&quot;&gt;&amp;#9644;&lt;/span&gt;&amp;nbsp;car commands&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#4F8C3C;font-size:22px&quot;&gt;&amp;#9644;&lt;/span&gt;&amp;nbsp;persistence&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#74549B;font-size:22px&quot;&gt;&amp;#9644;&lt;/span&gt;&amp;nbsp;REST / request-response&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#8A94A6;font-size:22px&quot;&gt;&amp;#9644;&lt;/span&gt;&amp;nbsp;out-of-band or bypass&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#475569;margin-top:10px&quot;&gt;Dashed outlines mark notes and optional components. Terminology follows the glossary in the repo&#x27;s &lt;i&gt;CONTEXT.md&lt;/i&gt;; the deployment profile decides which of the two Siren transports is actually running.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="48" y="1720" width="2020" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2-·-scylla-server-internals" name="2 · scylla-server internals"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2470" pageHeight="1552" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b style=&quot;font-size:34px;color:#0F172A&quot;&gt;scylla-server — ingest pipeline&lt;/b&gt;&lt;div style=&quot;font-size:17px;color:#64748B;margin-top:8px&quot;&gt;Every stage is its own Tokio task, wired together with bounded channels and shut down together on SIGINT&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="48" y="28" width="1500" height="80" as="geometry"/></mxCell><mxCell id="lane2" value="1 · Ingest" style="swimlane;html=1;rounded=1;arcSize=4;startSize=54;fillColor=#3C6DB0;strokeColor=#3C6DB0;strokeWidth=2;swimlaneFillColor=#EFF4FB;fontColor=#FFFFFF;fontSize=22;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=22;verticalAlign=middle;swimlaneLine=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="48" y="170" width="470" height="470" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b style=&quot;font-size:19px&quot;&gt;MqttProcessor&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;rumqttc v5 · SUBSCRIBE &lt;i&gt;#&lt;/i&gt; at QoS 0&lt;br&gt;clean start, 20 s keep-alive, session expiry 0&lt;br&gt;— the broker never replays a backlog&lt;br&gt;skips its own command echoes&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#DCE8F8;strokeColor=#3C6DB0;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane2"><mxGeometry x="24" y="78" width="422" height="170" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b style=&quot;font-size:19px&quot;&gt;ZenohProcessor&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;selected with &lt;i&gt;SCYLLA_ZENOH&lt;/i&gt; / &lt;i&gt;-z&lt;/i&gt;&lt;br&gt;config from &lt;i&gt;zenoh-scylla.json5&lt;/i&gt;&lt;br&gt;also owns command publishing&lt;br&gt;&lt;b&gt;only one transport runs at a time&lt;/b&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#DCE8F8;strokeColor=#3C6DB0;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane2"><mxGeometry x="24" y="276" width="422" height="170" as="geometry"/></mxCell><mxCell id="lane5" value="2 · Normalise" style="swimlane;html=1;rounded=1;arcSize=4;startSize=54;fillColor=#3C6DB0;strokeColor=#3C6DB0;strokeWidth=2;swimlaneFillColor=#EFF4FB;fontColor=#FFFFFF;fontSize=22;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=22;verticalAlign=middle;swimlaneLine=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="558" y="170" width="440" height="543" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b style=&quot;font-size:19px&quot;&gt;Decode &amp;amp; stamp&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;protobuf &lt;i&gt;serverdata&lt;/i&gt; → &lt;b&gt;ClientData&lt;/b&gt;&lt;br&gt;{ runId, name, unit, values[], timestamp }&lt;br&gt;stamps the run held in the RUN_ID atomic&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#DCE8F8;strokeColor=#3C6DB0;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane5"><mxGeometry x="24" y="78" width="392" height="145" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b style=&quot;font-size:19px&quot;&gt;Rate limiter&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;static per-topic window,&lt;br&gt;off by default&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#DCE8F8;strokeColor=#3C6DB0;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane5"><mxGeometry x="24" y="251" width="392" height="120" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b style=&quot;font-size:19px&quot;&gt;ArgosInserter&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quo