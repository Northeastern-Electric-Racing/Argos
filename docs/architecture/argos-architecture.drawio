<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="argos-architecture" name="Argos Architecture">
    <mxGraphModel dx="2600" dy="2100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="2050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ TITLE ============ -->
        <mxCell id="title" value="&lt;b&gt;Argos — real-time telemetry platform&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Northeastern Electric Racing · architecture as of 2026-09-16&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="600" height="48" as="geometry" />
        </mxCell>

        <!-- ============ GROUP CONTAINERS (declared first = behind) ============ -->
        <mxCell id="grpA" value="Vehicle (car side)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D79B00;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#B06000;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="400" height="700" as="geometry" />
        </mxCell>
        <mxCell id="grpB" value="Siren (transport)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#8C3A36;" vertex="1" parent="1">
          <mxGeometry x="490" y="60" width="340" height="480" as="geometry" />
        </mxCell>
        <mxCell id="grpC" value="scylla-server — Rust / Axum / Tokio  ·  :8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#3B5F91;" vertex="1" parent="1">
          <mxGeometry x="880" y="60" width="1000" height="1330" as="geometry" />
        </mxCell>
        <mxCell id="grpE" value="Clients &amp;amp; visualization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#6C4E80;" vertex="1" parent="1">
          <mxGeometry x="1960" y="60" width="420" height="790" as="geometry" />
        </mxCell>
        <mxCell id="grpD" value="Storage &amp;amp; files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82B366;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#5B8C3E;" vertex="1" parent="1">
          <mxGeometry x="1960" y="900" width="420" height="440" as="geometry" />
        </mxCell>
        <mxCell id="grpG" value="Deployment — compose profiles  (./argos.sh &amp;lt;profile&amp;gt; &amp;lt;docker cmd&amp;gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1440" width="1420" height="330" as="geometry" />
        </mxCell>
        <mxCell id="grpF" value="Charybdis — schema &amp;amp; data-sync tooling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#A38A1F;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1440" width="880" height="330" as="geometry" />
        </mxCell>

        <!-- ============ A — VEHICLE ============ -->
        <mxCell id="A1" value="&lt;b&gt;CAN nodes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;BMS · DTI · MPU · Charger · VCU&lt;br&gt;raise telemetry + fault codes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="115" width="340" height="85" as="geometry" />
        </mxCell>
        <mxCell id="A2" value="&lt;b&gt;CAN bus&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot;&gt;(SocketCAN — vcan0 in sim)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="225" width="340" height="45" as="geometry" />
        </mxCell>
        <mxCell id="A3" value="&lt;b&gt;Calypso&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot;&gt;(ghcr.io/…/calypso)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;CAN → protobuf encoder, publishes every topic&lt;br&gt;subscribes &lt;i&gt;Calypso/Bidir/Command/*&lt;/i&gt; → CAN writes&lt;br&gt;CALYPSO_ZENOH=true by default (MQTT fallback)&lt;br&gt;local stacks run the &lt;i&gt;zenoh-sim&lt;/i&gt; image instead&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="295" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="A4" value="&lt;b&gt;tpu profile — on-car collection node&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;scylla-server + Postgres run on the car itself&lt;br&gt;Siren is external (Mosquitto baked into Odysseus OS)&lt;br&gt;SCYLLA_RATE_LIMIT_MODE=static, 100 ms per topic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6EA;strokeColor=#D79B00;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="445" width="340" height="145" as="geometry" />
        </mxCell>
        <mxCell id="A5" value="&lt;b&gt;Odysseus logger / A-V daemon&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;writes protobuf &lt;i&gt;.cap&lt;/i&gt; logs + &lt;i&gt;.mp4&lt;/i&gt; clips offline,&lt;br&gt;then back-fills scylla over HTTP; cameras push RTSP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="615" width="340" height="115" as="geometry" />
        </mxCell>

        <!-- ============ B — SIREN ============ -->
        <mxCell id="B1" value="&lt;b&gt;Zenoh router&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot;&gt;(eclipse/zenoh)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;7447/tcp · 7446/udp&lt;br&gt;conf: siren-base/zenoh-router-docker.json5&lt;br&gt;&lt;b&gt;current default&lt;/b&gt; for router, client-dev, fake-data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="520" y="115" width="280" height="165" as="geometry" />
        </mxCell>
        <mxCell id="B2" value="&lt;b&gt;Mosquitto MQTT&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot;&gt;(eclipse-mosquitto)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;1883 · ws 9001→9002 · max_qos 2&lt;br&gt;allow_anonymous, persistence on, no queue cap&lt;br&gt;bridge &lt;i&gt;connection tpu&lt;/i&gt; → car 192.168.100.12 (mqtt v5)&lt;br&gt;used by scylla-dev, brick, tpu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="520" y="310" width="280" height="200" as="geometry" />
        </mxCell>

        <!-- ============ C — SCYLLA-SERVER (main pipeline) ============ -->
        <mxCell id="C1" value="&lt;b&gt;Ingest — one transport active at a time&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;MqttProcessor&lt;/b&gt; (rumqttc v5) — SUBSCRIBE &lt;i&gt;#&lt;/i&gt; @ QoS 0, clean_start, 20 s keep-alive, session expiry 0 (no replay backlog)&lt;br&gt;&lt;b&gt;ZenohProcessor&lt;/b&gt; — selected by SCYLLA_ZENOH / &lt;i&gt;-z&lt;/i&gt;, conf SCYLLA_ZENOH_CONF (zenoh-scylla.json5); also owns command publishing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="910" y="115" width="600" height="120" as="geometry" />
        </mxCell>
        <mxCell id="C2" value="&lt;b&gt;Decode · stamp · rate-limit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;protobuf &lt;i&gt;serverdata&lt;/i&gt; → ClientData&lt;br&gt;{ runId, name, unit, values[], timestamp }&lt;br&gt;stamps the active RUN_ID; drops &lt;i&gt;Calypso/Bidir/*&lt;/i&gt; echoes&lt;br&gt;static per-topic limiter (SCYLLA_RATE_LIMIT_MODE)&lt;br&gt;latency ring-buffer, 30 s heartbeat logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="910" y="265" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="C6" value="&lt;b&gt;ArgosInserter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;server-generated datapoints injected into the same broadcast&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1310" y="265" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="C3" value="&lt;b&gt;tokio broadcast fan-out&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 11px;&quot;&gt;db channel (cap 10 000)&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;socket channel (cap 10 000)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7D0F0;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="910" y="415" width="600" height="75" as="geometry" />
        </mxCell>
        <mxCell id="C4b" value="&lt;b&gt;socket_handler_with_metadata&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot;&gt;(socketioxide)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Socket.IO namespace &lt;i&gt;/&lt;/i&gt; — buffer 4096, ping/connect 5 s, ack 1.5 s&lt;br&gt;emits &lt;b&gt;data&lt;/b&gt; · &lt;b&gt;metadata&lt;/b&gt; · &lt;b&gt;faults&lt;/b&gt; · &lt;b&gt;timers&lt;/b&gt; · &lt;b&gt;rule_notify&lt;/b&gt;&lt;br&gt;optional load-shed via SCYLLA_SOCKET_DISCARD_PERCENT&lt;br&gt;&lt;b&gt;RuleManager&lt;/b&gt; — evalexpr boolean rules per topic, debounce interval, per-client subscriptions keyed on the &lt;i&gt;x-client-id&lt;/i&gt; header&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1010" y="520" width="500" height="190" as="geometry" />
        </mxCell>
        <mxCell id="C4a" value="&lt;b&gt;db_handler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;handling_loop&lt;/b&gt; — upserts new DataTypes (name + unit) on first sight, queues datapoints, forwards batches over mpsc (cap 1 000)&lt;br&gt;&lt;b&gt;batching_loop&lt;/b&gt; — chunked batch insert every SCYLLA_BATCH_UPSERT_TIME s (10 default, 20 on router); skippable via DATA_UPLOAD_DISABLE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="910" y="740" width="600" height="170" as="geometry" />
        </mxCell>
        <mxCell id="C7" value="&lt;b&gt;Axum REST router&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot;&gt;— permissive CORS, TraceLayer, Socket.IO layer mounted on the same listener&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;telemetry&lt;/b&gt;&amp;nbsp; GET /data/{dataType}/{runId} · GET /data/{dataType} (by timing) · GET /datatypes&lt;br&gt;&lt;b&gt;runs&lt;/b&gt;&amp;nbsp; GET /runs · /runs/latest · /runs/{id} · POST /runs/new[/{driver}/{location}/{notes}] · /runs/update/{id}/…&lt;br&gt;&lt;b&gt;rules&lt;/b&gt;&amp;nbsp; GET /rules · /rules/subscription-status · /rules/subscribed · PUT /rules/add · /rules/edit/{id} · POST /rules/delete/{id} · /rules/subscribe · /rules/unsubscribe&lt;br&gt;&lt;b&gt;car config&lt;/b&gt;&amp;nbsp; POST /config/set/{configKey}?data=…  → queues a SirenSendable&lt;br&gt;&lt;b&gt;live tuning&lt;/b&gt;&amp;nbsp; GET /scylla/get_settings · PUT /scylla/upload/{enable,disable} · /scylla/batch_time/{s} · /scylla/ratelimit_mode/{i} · /scylla/static_ratelimit_time/{ms} · /scylla/socket_discard_percent/{pct}&lt;br&gt;&lt;b&gt;back-fill&lt;/b&gt;&amp;nbsp; POST /insert/file · /insert/log (multipart, body limit off; run-id inferred from run time ranges) · /insert/update_logger · /insert/update_serial&lt;br&gt;&lt;b&gt;video&lt;/b&gt;&amp;nbsp; GET /videos · GET /videos/{file_name} (HTTP Range streaming) · POST /videos/update&lt;br&gt;&lt;b&gt;auth&lt;/b&gt;&amp;nbsp; POST /authenticate (SCYLLA_PASSWORD) gates privileged pages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="910" y="940" width="600" height="290" as="geometry" />
        </mxCell>
        <mxCell id="C8" value="&lt;b&gt;pub_handle&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot;&gt;— drains the SirenSendable mpsc (cap 100) and publishes protobuf &lt;i&gt;command_data&lt;/i&gt; to &lt;i&gt;Calypso/Bidir/Command/{key}&lt;/i&gt; at QoS 2 (Zenoh put in Zenoh mode)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="910" y="1260" width="600" height="90" as="geometry" />
        </mxCell>

        <!-- ============ C — side notes ============ -->
        <mxCell id="C10" value="&lt;b&gt;Observability &amp;amp; lifecycle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;tracing + EnvFilter (RUST_LOG, default INFO)&lt;br&gt;30 s per-task heartbeat logs, panic hook w/ backtrace&lt;br&gt;jemalloc global allocator&lt;br&gt;TaskTracker + CancellationToken: SIGINT drains the socket and DB tasks before exit&lt;br&gt;optional tokio-console via the &lt;i&gt;top&lt;/i&gt; feature&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FC;strokeColor=#9CB3D9;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1545" y="115" width="305" height="175" as="geometry" />
        </mxCell>
        <mxCell id="C11" value="&lt;b&gt;Migrations &amp;amp; connection pool&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Diesel embedded migrations run at boot on a throw-away connection&lt;br&gt;then bb8 async pool: max 10, min idle 2, 24 h lifetime, 2 min idle timeout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FC;strokeColor=#9CB3D9;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1545" y="320" width="305" height="165" as="geometry" />
        </mxCell>
        <mxCell id="C9" value="&lt;b&gt;Runtime knobs&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot;&gt;(atomics, live-tunable via /scylla/*)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;RUN_ID · DATA_UPLOAD_DISABLE · BATCH_UPSERT_TIME · RATE_LIMIT_MODE · STATIC_RATE_LIMIT_VALUE · SOCKET_DISCARD_PERCENT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FC;strokeColor=#9CB3D9;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1545" y="670" width="305" height="130" as="geometry" />
        </mxCell>
        <mxCell id="C12" value="&lt;b&gt;Derived / synthetic streams&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot;&gt;(socket-only unless noted)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Argos/Message_Rate · Argos/Viewers · Latency&lt;br&gt;faults binned from &lt;i&gt;DTI/Fault/FaultCode&lt;/i&gt; → Bms/Dti/Mpu/Charger, 8 s re-registration gap, expiry flag&lt;br&gt;timers over BMS/Status/Balancing · BMS/Status/State · BMS/Charging/Control&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FC;strokeColor=#9CB3D9;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1545" y="890" width="305" height="140" as="geometry" />
        </mxCell>
        <mxCell id="C13" value="&lt;b&gt;Config surface&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;SCYLLA_PORT (8000) · DATABASE_URL · SCYLLA_SIREN_HOST_URL · SCYLLA_ZENOH(_CONF) · SCYLLA_FILE_OUTPUT_DIRECTORY · SCYLLA_VIDEO_SUFFIX · SCYLLA_PASSWORD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FC;strokeColor=#9CB3D9;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1545" y="1240" width="305" height="110" as="geometry" />
        </mxCell>

        <!-- ============ E — CLIENTS ============ -->
        <mxCell id="E3" value="&lt;b&gt;Grafana&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot;&gt;:3000&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;grafana-zenoh-datasource (NER build, unsigned)&lt;br&gt;reads Zenoh live — bypasses scylla entirely&lt;br&gt;router + fake-data profiles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1990" y="115" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="E4" value="&lt;b&gt;siren-av — MediaMTX&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;bluenviron/mediamtx:latest-ffmpeg, host network&lt;br&gt;car cameras push RTSP; re-served to the camera page&lt;br&gt;router profile only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1990" y="265" width="360" height="115" as="geometry" />
        </mxCell>
        <mxCell id="E1" value="&lt;b&gt;angular-client&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot;&gt;— Angular 19 standalone + signals&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;served by nginx:alpine on :80; built once, then &lt;i&gt;envsubst&lt;/i&gt; injects BACKEND_URL / MAP_ACCESS_TOKEN into assets/env.js at container start (EnvService reads window.__env)&lt;br&gt;&lt;br&gt;&lt;b&gt;transport&lt;/b&gt;&amp;nbsp; socket.io-client → SocketService (fans events into Storage, FaultService, NotificationLogService; derives client-side latency) · REST via api.service + src/api/*&lt;br&gt;&lt;br&gt;&lt;b&gt;pages&lt;/b&gt;&amp;nbsp; landing · graph (presets, live strip, topic tree) · map (Mapbox) · charging · bms (per-cell heatmaps: C Volts / S Volts / CvS) · camera · faults (+ fault graph) · commands · rules · efuses · notification-log · lap-timer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1990" y="410" width="360" height="300" as="geometry" />
        </mxCell>
        <mxCell id="E2" value="&lt;b&gt;flutter-client&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot;&gt;(experimental)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;second client for web / Android / Linux; consumes the same Socket.IO + REST surface&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EAF5;strokeColor=#9673A6;dashed=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1990" y="740" width="360" height="90" as="geometry" />
        </mxCell>

        <!-- ============ D — STORAGE ============ -->
        <mxCell id="D2" value="&lt;b&gt;files/&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot;&gt;(SCYLLA_FILE_OUTPUT_DIRECTORY)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;uploaded &lt;i&gt;.cap&lt;/i&gt; protobuf logs + &lt;i&gt;.mp4&lt;/i&gt; clips&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1990" y="955" width="360" height="85" as="geometry" />
        </mxCell>
        <mxCell id="D1" value="&lt;b&gt;odyssey-db — Postgres 17.2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;shared_buffers 256 MB · trust auth · named volume &lt;i&gt;db-data&lt;/i&gt; (survives &lt;i&gt;down&lt;/i&gt;, wiped with &lt;i&gt;down -v&lt;/i&gt;)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;run&lt;/b&gt;(runId pk, driverName, locationName, notes, time)&lt;br&gt;&lt;b&gt;data_type&lt;/b&gt;(name pk, unit)&lt;br&gt;&lt;b&gt;data&lt;/b&gt;(values float4[], time int8 µs, dataTypeName, runId)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;pk (time, dataTypeName) → data_type, run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1990" y="1070" width="360" height="240" as="geometry" />
        </mxCell>

        <!-- ============ F — CHARYBDIS ============ -->
        <mxCell id="F1" value="&lt;b&gt;charybdis CLI&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot;&gt;(Node / TS)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;interactive or flag-driven&lt;br&gt;&lt;b&gt;dump&lt;/b&gt; local → disk&amp;nbsp;·&amp;nbsp;&lt;b&gt;upload&lt;/b&gt; disk → cloud&amp;nbsp;·&amp;nbsp;&lt;b&gt;audit&lt;/b&gt;&lt;br&gt;batched, CSV transformers, runs in its own container&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1530" y="1500" width="270" height="230" as="geometry" />
        </mxCell>
        <mxCell id="F2" value="&lt;b&gt;local-prisma&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;source of truth for the local schema; regenerating it re-emits scylla's Diesel migration + schema.rs so Rust and Prisma stay in lockstep&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1830" y="1500" width="250" height="230" as="geometry" />
        </mxCell>
        <mxCell id="F3" value="&lt;b&gt;cloud-prisma → Cloud Postgres&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;separate migration history (unique_run); long-term archive of every run pulled off the car&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2110" y="1500" width="240" height="230" as="geometry" />
        </mxCell>

        <!-- ============ G — PROFILES ============ -->
        <mxCell id="G1" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;router&lt;/b&gt;&amp;nbsp; base station: scylla (Zenoh, batch 20 s) + client + Grafana + MediaMTX; Zenoh router runs on the host AP&lt;br&gt;&lt;b&gt;brick&lt;/b&gt;&amp;nbsp; box plugged into the base station purely to collect: scylla → Siren at 192.168.100.11:1883, no rate limit, client comes from the router&lt;br&gt;&lt;b&gt;tpu&lt;/b&gt;&amp;nbsp; on-car node: scylla + DB only, Siren external on the host, static 100 ms rate limit&lt;br&gt;&lt;b&gt;client-dev&lt;/b&gt;&amp;nbsp; everything in Docker incl. scylla (Zenoh) + Calypso sim — point your own &lt;i&gt;ng serve&lt;/i&gt; at it&lt;br&gt;&lt;b&gt;scylla-dev&lt;/b&gt;&amp;nbsp; everything except scylla (Mosquitto Siren + Calypso over MQTT + locally built client) — run &lt;i&gt;cargo run&lt;/i&gt; yourself&lt;br&gt;&lt;b&gt;fake-data&lt;/b&gt;&amp;nbsp; Zenoh + Calypso sim + Grafana, no scylla&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;db&lt;/b&gt;&amp;nbsp; Postgres alone&lt;br&gt;&lt;br&gt;Images publish to ghcr.io/northeastern-electric-racing/{argos-scylla, argos-client}. Ports are env-overridable (ODYSSEY_DB_PORT, SCYLLA_HOST_PORT, CLIENT_HOST_PORT, SIREN_MQTT_PORT, SIREN_WS_PORT, GRAFANA_HOST_PORT) and STACK_OFFSET namespaces the compose project so stacks can run side by side — except the Zenoh router, whose 7447/7446 are still fixed.&lt;br&gt;&lt;br&gt;&lt;b&gt;CI&lt;/b&gt;&amp;nbsp; four path-filtered workflows gate every PR — client-ci &amp;amp; test-check (angular-client), scylla-ci (scylla-server), build-check (scylla-server + compose); each reports through an always-run &lt;i&gt;*-gate&lt;/i&gt; job. client-flutter-ci filters at the trigger with no gate.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9AA5B1;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="1495" width="1360" height="245" as="geometry" />
        </mxCell>

        <!-- ============ LEGEND ============ -->
        <mxCell id="LEG" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Legend&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#1F6FD0&quot;&gt;━━&lt;/font&gt; telemetry (car → store/screen)&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#B85450&quot;&gt;━━&lt;/font&gt; car commands (screen → CAN)&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#5B8C3E&quot;&gt;━━&lt;/font&gt; persistence&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#7D5BA6&quot;&gt;━━&lt;/font&gt; REST / request-response&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#808080&quot;&gt;╌╌&lt;/font&gt; out-of-band or bypass path&amp;nbsp;&amp;nbsp;&amp;nbsp; dashed boxes = notes, optional components, or profile-specific deployments&lt;br&gt;&lt;br&gt;&lt;b&gt;Reading it&lt;/b&gt;&amp;nbsp; CAN nodes → Calypso encodes to protobuf → Siren (Zenoh today, Mosquitto on the older profiles) → scylla-server decodes, stamps the active run, and forks the stream: one branch batch-inserts into Postgres, the other pushes it live over Socket.IO. Commands travel the reverse path through &lt;i&gt;Calypso/Bidir/Command/*&lt;/i&gt;. Grafana taps Zenoh directly; Charybdis moves finished runs from the local DB to the cloud archive. Terminology follows the root &lt;i&gt;CONTEXT.md&lt;/i&gt; glossary.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1820" width="2340" height="150" as="geometry" />
        </mxCell>

