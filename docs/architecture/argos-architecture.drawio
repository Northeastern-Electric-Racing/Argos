<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="1-·-system-architecture" name="1 · System Architecture"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="1890" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b style=&quot;font-size:34px;color:#0F172A&quot;&gt;Argos — real-time telemetry platform&lt;/b&gt;&lt;div style=&quot;font-size:17px;color:#64748B;margin-top:8px&quot;&gt;Northeastern Electric Racing &amp;nbsp;·&amp;nbsp; how the system fits together as of 2026-09-16 &amp;nbsp;·&amp;nbsp; pipeline internals on page 2, API &amp;amp; deployment reference on page 3&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="48" y="28" width="1500" height="80" as="geometry"/></mxCell><mxCell id="lane2" value="Vehicle" style="swimlane;html=1;rounded=1;arcSize=4;startSize=54;fillColor=#C97A0E;strokeColor=#C97A0E;strokeWidth=2;swimlaneFillColor=#FFF6E8;fontColor=#FFFFFF;fontSize=22;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=22;verticalAlign=middle;swimlaneLine=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="48" y="150" width="430" height="543" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b style=&quot;font-size:19px&quot;&gt;CAN nodes&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;BMS · DTI · MPU · Charger · VCU&lt;br&gt;telemetry and fault codes&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#FFEDD1;strokeColor=#C97A0E;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane2"><mxGeometry x="24" y="78" width="382" height="120" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b style=&quot;font-size:19px&quot;&gt;Calypso&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;CAN ⇄ protobuf gateway — publishes every&lt;br&gt;topic upstream, and turns &lt;i&gt;Calypso/Bidir/&lt;/i&gt;&lt;br&gt;&lt;i&gt;Command/*&lt;/i&gt; back into CAN writes&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#FFEDD1;strokeColor=#C97A0E;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane2"><mxGeometry x="24" y="226" width="382" height="145" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b style=&quot;font-size:19px&quot;&gt;Odysseus logger&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;records &lt;i&gt;.cap&lt;/i&gt; logs and &lt;i&gt;.mp4&lt;/i&gt; clips when the&lt;br&gt;link is down, then back-fills later&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#FFEDD1;strokeColor=#C97A0E;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane2"><mxGeometry x="24" y="399" width="382" height="120" as="geometry"/></mxCell><mxCell id="lane6" value="Siren — transport" style="swimlane;html=1;rounded=1;arcSize=4;startSize=54;fillColor=#C0504A;strokeColor=#C0504A;strokeWidth=2;swimlaneFillColor=#FDF0EF;fontColor=#FFFFFF;fontSize=22;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=22;verticalAlign=middle;swimlaneLine=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="518" y="150" width="380" height="455" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b style=&quot;font-size:19px&quot;&gt;Zenoh router&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;eclipse/zenoh · 7447 tcp · 7446 udp&lt;br&gt;&lt;b&gt;default transport today&lt;/b&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#FADDDA;strokeColor=#C0504A;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=center;spacingLeft=14;spacingRight=14;spacingTop=12;shape=hexagon;perimeter=hexagonPerimeter2;size=0.09;" vertex="1" parent="lane6"><mxGeometry x="24" y="78" width="332" height="150" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b style=&quot;font-size:19px&quot;&gt;Mosquitto MQTT&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;1883 · QoS ≤ 2 · persistent&lt;br&gt;bridged to the car&#x27;s broker&lt;br&gt;scylla-dev · brick · tpu&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#FADDDA;strokeColor=#C0504A;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=center;spacingLeft=14;spacingRight=14;spacingTop=12;shape=hexagon;perimeter=hexagonPerimeter2;size=0.09;" vertex="1" parent="lane6"><mxGeometry x="24" y="256" width="332" height="175" as="geometry"/></mxCell><mxCell id="lane9" value="scylla-server — Rust / Axum / Tokio · :8000" style="swimlane;html=1;rounded=1;arcSize=4;startSize=54;fillColor=#3C6DB0;strokeColor=#3C6DB0;strokeWidth=2;swimlaneFillColor=#EFF4FB;fontColor=#FFFFFF;fontSize=22;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=22;verticalAlign=middle;swimlaneLine=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="938" y="150" width="620" height="1017" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b style=&quot;font-size:19px&quot;&gt;Ingest&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;&lt;b&gt;MqttProcessor&lt;/b&gt; (SUBSCRIBE &lt;i&gt;#&lt;/i&gt;) or &lt;b&gt;ZenohProcessor&lt;/b&gt;&lt;br&gt;decodes protobuf, stamps the active run,&lt;br&gt;optional per-topic rate limit&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#DCE8F8;strokeColor=#3C6DB0;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane9"><mxGeometry x="24" y="78" width="572" height="145" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b style=&quot;font-size:19px&quot;&gt;Broadcast fan-out&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;one copy to disk, one to the screen&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#DCE8F8;strokeColor=#3C6DB0;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;shape=process;size=0.045;rounded=1;arcSize=4;" vertex="1" parent="lane9"><mxGeometry x="24" y="251" width="572" height="100" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b style=&quot;font-size:19px&quot;&gt;socket_handler + RuleManager&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;pushes &lt;b&gt;data · metadata · faults · timers · rule_notify&lt;/b&gt;&lt;br&gt;evaluates user rules per topic and notifies&lt;br&gt;only the clients subscribed to them&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#DCE8F8;strokeColor=#3C6DB0;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane9"><mxGeometry x="144" y="379" width="452" height="145" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b style=&quot;font-size:19px&quot;&gt;db_handler&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;registers new DataTypes on first sight,&lt;br&gt;queues datapoints, batch-inserts on a timer&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#DCE8F8;strokeColor=#3C6DB0;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane9"><mxGeometry x="24" y="552" width="572" height="120" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b style=&quot;font-size:19px&quot;&gt;Axum REST API&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;history · runs · rules · car config · live tuning&lt;br&gt;log &amp;amp; video upload and playback&lt;br&gt;&lt;i&gt;full route list on page 3&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#DCE8F8;strokeColor=#3C6DB0;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane9"><mxGeometry x="24" y="700" width="572" height="145" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b style=&quot;font-size:19px&quot;&gt;pub_handle&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;publishes protobuf commands to&lt;br&gt;&lt;i&gt;Calypso/Bidir/Command/{key}&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#DCE8F8;strokeColor=#3C6DB0;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane9"><mxGeometry x="24" y="873" width="572" height="120" as="geometry"/></mxCell><mxCell id="lane16" value="Clients &amp;amp; visualization" style="swimlane;html=1;rounded=1;arcSize=4;startSize=54;fillColor=#74549B;strokeColor=#74549B;strokeWidth=2;swimlaneFillColor=#F4F0F9;fontColor=#FFFFFF;fontSize=22;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=22;verticalAlign=middle;swimlaneLine=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1638" y="150" width="430" height="651" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b style=&quot;font-size:19px&quot;&gt;Grafana&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;Zenoh datasource — reads the bus&lt;br&gt;directly, bypassing scylla&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#E6DAF2;strokeColor=#74549B;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane16"><mxGeometry x="24" y="78" width="382" height="120" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b style=&quot;font-size:19px&quot;&gt;siren-av · MediaMTX&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;RTSP / WebRTC video relay&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#E6DAF2;strokeColor=#74549B;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane16"><mxGeometry x="24" y="226" width="382" height="100" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b style=&quot;font-size:19px&quot;&gt;angular-client&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;Angular 19 dashboard behind nginx&lt;br&gt;live telemetry · graphs · map · BMS heatmaps&lt;br&gt;faults · rules · commands · lap timer&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#E6DAF2;strokeColor=#74549B;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane16"><mxGeometry x="24" y="354" width="382" height="145" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b style=&quot;font-size:19px&quot;&gt;flutter-client&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;experimental second client, same APIs&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#E6DAF2;strokeColor=#74549B;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane16"><mxGeometry x="24" y="527" width="382" height="100" as="geometry"/></mxCell><mxCell id="lane21" value="Storage" style="swimlane;html=1;rounded=1;arcSize=4;startSize=54;fillColor=#4F8C3C;strokeColor=#4F8C3C;strokeWidth=2;swimlaneFillColor=#F0F7ED;fontColor=#FFFFFF;fontSize=22;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=22;verticalAlign=middle;swimlaneLine=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1638" y="860" width="430" height="430" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b style=&quot;font-size:19px&quot;&gt;files/&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;uploaded &lt;i&gt;.cap&lt;/i&gt; logs and &lt;i&gt;.mp4&lt;/i&gt; clips&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#DCEDD5;strokeColor=#4F8C3C;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;shape=note;size=22;" vertex="1" parent="lane21"><mxGeometry x="24" y="78" width="382" height="100" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b style=&quot;font-size:19px&quot;&gt;odyssey-db · Postgres 17.2&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;&lt;b&gt;run&lt;/b&gt; · &lt;b&gt;data_type&lt;/b&gt; · &lt;b&gt;data&lt;/b&gt;&lt;br&gt;Diesel migrations run at boot&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#DCEDD5;strokeColor=#4F8C3C;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;verticalAlign=top;spacingTop=38;" vertex="1" parent="lane21"><mxGeometry x="24" y="206" width="382" height="200" as="geometry"/></mxCell><mxCell id="lane24" value="Charybdis — schema &amp;amp; data sync" style="swimlane;html=1;rounded=1;arcSize=4;startSize=54;fillColor=#A8862A;strokeColor=#A8862A;strokeWidth=2;swimlaneFillColor=#FBF6E7;fontColor=#FFFFFF;fontSize=22;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=22;verticalAlign=middle;swimlaneLine=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="48" y="1400" width="1510" height="272" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b style=&quot;font-size:19px&quot;&gt;charybdis CLI&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;&lt;b&gt;dump · upload · audit&lt;/b&gt;&lt;br&gt;moves finished runs off the local DB&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#F6EAC4;strokeColor=#A8862A;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane24"><mxGeometry x="24" y="78" width="468" height="170" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b style=&quot;font-size:19px&quot;&gt;local-prisma&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;schema source of truth — regenerating it&lt;br&gt;re-emits scylla&#x27;s Diesel migration&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#F6EAC4;strokeColor=#A8862A;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane24"><mxGeometry x="520" y="78" width="468" height="170" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b style=&quot;font-size:19px&quot;&gt;Cloud Postgres&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;long-term archive&lt;br&gt;(cloud-prisma migrations)&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#F6EAC4;strokeColor=#A8862A;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;verticalAlign=top;spacingTop=38;" vertex="1" parent="lane24"><mxGeometry x="1016" y="78" width="468" height="170" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b style=&quot;font-size:19px&quot;&gt;Reading order&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;&lt;b&gt;1.&lt;/b&gt;&amp;nbsp; CAN nodes raise telemetry; Calypso encodes it to protobuf.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt;&amp;nbsp; Siren carries it — Zenoh today, Mosquitto on the older profiles.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt;&amp;nbsp; scylla-server decodes it, stamps the active run, and forks:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;one copy batches into Postgres, one goes live over Socket.IO.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt;&amp;nbsp; The dashboard reads live data over the socket, history over REST.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt;&amp;nbsp; Commands travel the reverse path back down to CAN.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt;&amp;nbsp; Charybdis later lifts finished runs into the cloud archive.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#EEF1F5;strokeColor=#94A3B8;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="48" y="740" width="560" height="245" as="geometry"/></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;strokeColor=#1F6FD0;strokeWidth=3;fontFamily=Helvetica;fontSize=14;fontColor=#1F6FD0;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="telemetry ▲  commands ▼" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;strokeColor=#1F6FD0;strokeWidth=3;fontFamily=Helvetica;fontSize=14;fontColor=#1F6FD0;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n7"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset"/><Array as="points"><mxPoint x="498" y="420"/><mxPoint x="498" y="318"/></Array></mxGeometry></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;strokeColor=#1F6FD0;strokeWidth=3;fontFamily=Helvetica;fontSize=14;fontColor=#1F6FD0;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="498" y="485"/><mxPoint x="498" y="476"/></Array></mxGeometry></mxCell><mxCell id="e32" value="Zenoh subscribe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;strokeColor=#1F6FD0;strokeWidth=3;fontFamily=Helvetica;fontSize=14;fontColor=#1F6FD0;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="918" y="303"/><mxPoint x="918" y="279"/></Array></mxGeometry></mxCell><mxCell id="e33" value="SUBSCRIBE &lt;i&gt;#&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;strokeColor=#1F6FD0;strokeWidth=3;fontFamily=Helvetica;fontSize=14;fontColor=#1F6FD0;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="918" y="494"/><mxPoint x="918" y="337"/></Array></mxGeometry></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;strokeColor=#1F6FD0;strokeWidth=3;fontFamily=Helvetica;fontSize=14;fontColor=#1F6FD0;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e35" value="socket channel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;strokeColor=#1F6FD0;strokeWidth=3;fontFamily=Helvetica;fontSize=14;fontColor=#1F6FD0;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.62;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36" value="db channel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;strokeColor=#1F6FD0;strokeWidth=3;fontFamily=Helvetica;fontSize=14;fontColor=#1F6FD0;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;exitX=0.08;exitY=1;exitDx=0;exitDy=0;entryX=0.08;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e37" value="Socket.IO (ws)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;strokeColor=#1F6FD0;strokeWidth=3;fontFamily=Helvetica;fontSize=14;fontColor=#1F6FD0;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.67;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" value="REST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;strokeColor=#74549B;strokeWidth=3;fontFamily=Helvetica;