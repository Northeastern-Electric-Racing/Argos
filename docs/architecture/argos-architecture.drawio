790" width="2370" height="292" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b style=&quot;font-size:19px&quot;&gt;Live-tunable atomics&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;RUN_ID · DATA_UPLOAD_DISABLE&lt;br&gt;BATCH_UPSERT_TIME · RATE_LIMIT_MODE&lt;br&gt;STATIC_RATE_LIMIT_VALUE&lt;br&gt;SOCKET_DISCARD_PERCENT&lt;br&gt;all reachable over &lt;i&gt;/scylla/*&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#EEF1F5;strokeColor=#94A3B8;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane18"><mxGeometry x="24" y="78" width="559" height="190" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b style=&quot;font-size:19px&quot;&gt;Observability&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;tracing + EnvFilter (&lt;i&gt;RUST_LOG&lt;/i&gt;)&lt;br&gt;30 s per-task heartbeat logs&lt;br&gt;panic hook with backtrace&lt;br&gt;jemalloc allocator&lt;br&gt;tokio-console behind the &lt;i&gt;top&lt;/i&gt; feature&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#EEF1F5;strokeColor=#94A3B8;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane18"><mxGeometry x="611" y="78" width="559" height="190" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b style=&quot;font-size:19px&quot;&gt;Database access&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;Diesel migrations embedded in the binary,&lt;br&gt;run at boot on a throw-away connection,&lt;br&gt;then a bb8 pool: max 10, min idle 2,&lt;br&gt;24 h lifetime, 2 min idle timeout&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#EEF1F5;strokeColor=#94A3B8;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane18"><mxGeometry x="1198" y="78" width="559" height="190" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b style=&quot;font-size:19px&quot;&gt;Graceful shutdown&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;a TaskTracker plus one CancellationToken&lt;br&gt;SIGINT cancels, then waits for the socket&lt;br&gt;and DB tasks to drain before exit&lt;br&gt;so queued datapoints still land&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#EEF1F5;strokeColor=#94A3B8;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane18"><mxGeometry x="1785" y="78" width="559" height="190" as="geometry"/></mxCell><mxCell id="lane23" value="Command return path" style="swimlane;html=1;rounded=1;arcSize=4;startSize=54;fillColor=#C0504A;strokeColor=#C0504A;strokeWidth=2;swimlaneFillColor=#FDF0EF;fontColor=#FFFFFF;fontSize=22;fontStyle=1;fontFamily=Helvetica;align=left;spacingLeft=22;verticalAlign=middle;swimlaneLine=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="48" y="1122" width="2370" height="222" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b style=&quot;font-size:19px&quot;&gt;POST /config/set/{key}&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#475569;line-height:150%;margin-top:6px&quot;&gt;from the dashboard&#x27;s command page; an empty&lt;br&gt;body means &quot;use the cangen default&quot;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fillColor=#FADDDA;strokeColor=#C0504A;strokeWidth=2;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;rounded=1;arcSize=8;" vertex="1" parent="lane23"><mxGeometry x="24" y="78" width="755" height="120" as="geometry"/></mxCell><mxCell 