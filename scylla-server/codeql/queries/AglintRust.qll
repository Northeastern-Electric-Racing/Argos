/**
 * AGLint Rust library: application functions, the call graph, outcome sinks and the `<rel-path>#<qualname>` symbols
 * shared by Influence.ql and Purity.ql (SPEC-v2 sections 2.2, 2.3).
 *
 * A copy lives next to Purity.ql (codeql/purity/AglintRust.qll): keep the two byte-equal (a core test checks it).
 *
 * Known gaps, by design reported rather than guessed (they are the blind-* ast-grep rules):
 * - a call through a function value stored in a struct field, `(h.on_save)(..)`, has no target: it is an
 *   `unresolved-call`, and the callee's effects are not attributed to the caller;
 * - `dyn Trait` and generic calls resolve to every impl (an over-approximation).
 *
 * Diesel is modelled here, not only by sink rows: CodeQL cannot type the unit struct a `diesel::table!` generates, so a
 * query on a table (`users.filter(..).load(conn)`) has no call target, and `get_result(s)` reads or writes depending on
 * the query it runs. `dieselRun` reads the query chain instead (see there).
 */

import rust
import codeql.rust.dataflow.DataFlow
import codeql.rust.dataflow.FlowSink
private import codeql.rust.dataflow.internal.Node as N
private import codeql.rust.internal.PathResolution as PR

/** A source file of the application: in the source root, not vendored, not a test, bench, example or build script. */
predicate appFile(File file) {
  exists(string p | p = file.getRelativePath() |
    p.matches("%.rs") and
    not p.regexpMatch("(.*/)?(vendor|third_party|tests|benches|examples|target)/.*") and
    not p.regexpMatch("(.*/)?build\\.rs")
  )
}

/** An application function: written in an app file (not generated by a derive or macro), not a test. */
predicate appFunction(Function f) {
  appFile(f.getFile()) and
  not f.isFromMacroExpansion() and
  not dieselSchemaItem(f) and
  not f.getCanonicalPath().matches("%::tests::%") and
  not f.getAnAttr().(Attr).getMeta().(PathMeta).getPath().getText() = "test"
}

/**
 * The qualified name of `f` inside its file: `name` for a free function, `Type::name` for an associated function or
 * a trait method implementation (`<store::User as core::fmt::Debug>::fmt` -> `User::fmt`).
 */
string qualName(Function f) {
  exists(string cp | cp = f.getCanonicalPath() |
    if cp.matches("<%")
    then result = cp.regexpCapture("<(?:[^<> ]*::)?([^<> :]+)(?:<.*>)?(?: as [^>]*)?>::.*", 1) + "::" + f.getName().getText()
    else result = f.getName().getText()
  )
  or
  not exists(f.getCanonicalPath()) and result = f.getName().getText()
}

/** `<rel-path>#<qualname>`, the symbol every AGLint Rust tool emits (trace frames, purity rows, influence rows). */
string symbol(Function f) { result = f.getFile().getRelativePath() + "#" + qualName(f) }

/** `a` calls `b`: a resolved call target, or a closure defined in `a` (its body runs on a's behalf). */
predicate calls(Callable a, Callable b) {
  exists(Call c | c.getEnclosingCallable() = a and b = c.getARuntimeTarget())
  or
  b.(ClosureExpr).getEnclosingCallable() = a
}

/** `f` performs an outcome itself: a sink of the aglint model pack (codeql/models) is inside `f`. */
predicate directSink(Callable f, string kind) {
  exists(DataFlow::Node n | sinkNode(n, kind) and n.(N::Node).getCfgScope() = f and not dieselRunOperand(n)) and
  kind.matches("aglint-%")
  or
  exists(MethodCallExpr mc | dieselRun(mc, kind) and mc.getEnclosingCallable() = f)
}

/* ------------------------------------------------------------------------------------------------ Diesel */

/** An item `diesel::table!` (or `joinable!`, `allow_tables_to_appear_in_same_query!`) generates in the schema file. */
predicate dieselSchemaItem(AstNode n) {
  n.isInMacroExpansion() and
  exists(MacroCall mc |
    mc.getPath().getText() = ["table", "joinable", "allow_tables_to_appear_in_same_query"] and
    not mc.isInMacroExpansion() and
    mc.getFile() = n.getFile() and
    mc.getLocation().contains(n.getLocation())
  )
}

/** A Diesel table (`users::table`, or its `users::dsl::users` alias): the unit struct `table` of a `table!`. */
predicate dieselTable(PathExpr p) {
  exists(Struct s | s = PR::resolvePath(p.getPath()) |
    s.getName().getText() = "table" and s.isInMacroExpansion()
  )
}

/** A Diesel statement constructor, `diesel::insert_into(t)` ...: `write` for the ones that change rows. */
predicate dieselStatement(CallExpr c, boolean write) {
  exists(Path p, string n | p = c.getFunction().(PathExpr).getPath() and n = p.getText() |
    (
      p.getQualifier().getText() = "diesel" or
      c.(Call).getStaticTarget().getCanonicalPath().regexpMatch("<?diesel::.*")
    ) and
    (
      n = ["insert_into", "insert_or_ignore_into", "replace_into", "update", "delete"] and write = true
      or
      n = ["select", "sql_query"] and write = false
    )
  )
}

/** A method of Diesel's query builders (`QueryDsl`, the insert / update / delete statements). */
bindingset[m]
predicate dieselBuilderMethod(string m) {
  m =
    [
      "filter", "or_filter", "select", "order", "order_by", "then_order_by", "limit", "offset", "find", "inner_join",
      "left_join", "left_outer_join", "group_by", "having", "distinct", "distinct_on", "into_boxed", "for_update",
      "for_no_key_update", "for_share", "for_key_share", "skip_locked", "no_wait", "count", "single_value", "nullable",
      "values", "set", "default_values", "into_columns", "on_conflict", "on_conflict_do_nothing", "do_update",
      "do_nothing", "returning", "bind"
    ]
}

/**
 * `e` is a Diesel query: a table, a statement constructor, a query-builder method on one, or a local variable bound to
 * one. `write` when the query inserts, updates or deletes rows.
 */
predicate dieselQuery(Expr e, boolean write) {
  dieselTable(e) and write = false
  or
  dieselStatement(e, write)
  or
  exists(MethodCallExpr mc | mc = e and dieselBuilderMethod(mc.getIdentifier().getText()) |
    dieselQuery(mc.getReceiver(), write)
  )
  or
  dieselQuery(e.(ParenExpr).getExpr(), write)
  or
  exists(Variable v | e = v.getAnAccess() and dieselQuery(v.getInitializer(), write))
}

/**
 * A Diesel run call (`RunQueryDsl` of diesel or diesel-async: `.load(conn)`, `.first(conn)`, `.get_result(s)(conn)`,
 * `.execute(conn)`) and its sink kind: `aglint-db-write` for `execute` and for any run of an insert, update or delete,
 * `aglint-db-read` otherwise. The call either has no target (the usual case: a query on a `table!` struct) and runs a
 * query `dieselQuery` recognises, or resolves into diesel / diesel-async; then a query AGLint cannot see (a parameter, a
 * field) goes by the method: `execute` and `get_result(s)` write (INSERT ... RETURNING), `load` and `first` read.
 */
predicate dieselRun(MethodCallExpr mc, string kind) {
  exists(string m, boolean write |
    m = mc.getIdentifier().getText() and
    m = ["load", "load_iter", "load_stream", "get_result", "get_results", "first", "execute"] and
    mc.getArgList().getNumberOfArgs() = 1 and
    (
      not exists(mc.getStaticTarget())
      or
      mc.getStaticTarget().getCanonicalPath().regexpMatch("<?(.* as )?diesel(_async)?::.*")
    ) and
    (
      dieselQuery(mc.getReceiver(), write)
      or
      not dieselQuery(mc.getReceiver(), _) and
      exists(mc.getStaticTarget()) and
      if m = ["execute", "get_result", "get_results"] then write = true else write = false
    ) and
    if write = true or m = "execute" then kind = "aglint-db-write" else kind = "aglint-db-read"
  )
}

/**
 * A model-pack sink at the receiver of a Diesel run call (the `Argument[self]` rows of the diesel tables; a model sink
 * is a flow-summary node located at that receiver): `dieselRun` decides its kind instead, since a `get_result` may
 * only read.
 */
predicate dieselRunOperand(DataFlow::Node n) {
  exists(MethodCallExpr mc | dieselRun(mc, _) | n.getLocation().toString() = mc.getReceiver().getLocation().toString())
}

/**
 * A call of Diesel's DSL that Purity.ql need not report as unresolved: a query-builder or run call on a query
 * `dieselQuery` recognises, and diesel's `.optional()` on a run's result (also after `.await`).
 */
predicate dieselCall(Call c) {
  dieselQuery(c, _)
  or
  dieselRun(c, _)
  or
  exists(MethodCallExpr mc, Expr r | mc = c and mc.getIdentifier().getText() = "optional" |
    r = mc.getReceiver() and
    (dieselRun(r, _) or dieselRun(r.(AwaitExpr).getExpr(), _))
  )
}

/**
 * The callee as written, for `unresolved-call:<text>`: `(hooks.on_signup)` for a call through a field, `recv.name` for a
 * method call, otherwise the call's own text without its arguments.
 */
string calleeText(Call c) {
  exists(FieldExpr fe | fe = c.(CallExpr).getFunction().(ParenExpr).getExpr() |
    result = "(" + fe.getContainer().toString() + "." + fe.getIdentifier().getText() + ")"
  )
  or
  not c.(CallExpr).getFunction() instanceof ParenExpr and
  (
    result = c.(MethodCallExpr).getReceiver().toString() + "." + c.(MethodCallExpr).getIdentifier().getText()
    or
    not c instanceof MethodCallExpr and result = c.toString().regexpReplaceAll("\\(\\.\\.\\.\\)$", "")
  )
}

/** An app function (or the app function enclosing a closure) that `c` reaches, reflexively. */
predicate reaches(Callable f, Callable g) { calls*(f, g) }

/** A source file of a vendored (third-party) crate inside the source tree. */
predicate vendorFile(File file) { file.getRelativePath().regexpMatch("(.*/)?(vendor|third_party)/.*\\.rs") }

/**
 * A vendored function that `f` calls directly. The influence rows name it after the app functions with the sink, so
 * the trust tier of the vendored crate is on the outcome path.
 */
predicate vendorCallee(Callable f, Function v) {
  exists(Call c | c.getEnclosingCallable() = f and v = c.getStaticTarget()) and vendorFile(v.getFile())
}

/** `f` reaches an app function with a direct sink of `kind`; `g` is that function. */
predicate reachesSink(Function f, string kind, Function g) {
  appFunction(g) and
  exists(Callable h | reaches(f, h) and directSink(h, kind) and (h = g or h.(ClosureExpr).getEnclosingCallable+() = g))
}
